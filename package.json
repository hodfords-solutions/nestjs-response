{
    "name": "@hodfords/nestjs-response",
    "version": "11.1.0",
    "description": "Standardizes and validates API responses in NestJS for consistent and reliable communication",
    "author": "",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-response.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "format": "prettier --write \"sample/**/*.ts\" \"test/**/*.ts\" \"lib/**/*.ts\"",
        "start": "nest start",
        "start:dev": "npm run prebuild && nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{sample,apps,lib,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "wz-command": "wz-command",
        "prepare": "is-ci || husky",
        "version": "auto-changelog && git add CHANGELOG.md",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "lint-staged": "lint-staged",
        "cspell": "cspell"
    },
    "devDependencies": {
        "@grpc/grpc-js": "^1.12.4",
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/cli": "11.0.16",
        "@nestjs/common": "11.1.12",
        "@nestjs/core": "11.1.12",
        "@nestjs/platform-express": "11.1.12",
        "@nestjs/schematics": "11.0.9",
        "@nestjs/swagger": "11.2.5",
        "@nestjs/testing": "11.1.12",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "25.2.0",
        "@types/supertest": "6.0.3",
        "auto-changelog": "2.5.0",
        "class-transformer": "0.5.1",
        "class-validator": "npm:@hodfords/turbo-validator@1.0.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "jest": "30.2.0",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "rxjs": "7.8.2",
        "source-map-support": "0.5.21",
        "supertest": "7.2.2",
        "ts-jest": "29.4.6",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.9.3"
    },
    "overrides": {
        "lodash": "4.17.23"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            ".+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/sample/",
            "<rootDir>/lib/"
        ],
        "moduleDirectories": [
            "node_modules",
            "<rootDir>"
        ],
        "moduleNameMapper": {
            "@hodfords/nestjs-response(|/.*)$": "<rootDir>/lib/nestjs-response/sample/$1"
        }
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3"
    }
}
