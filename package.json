{
    "name": "@hodfords/nestjs-response",
    "version": "11.1.5",
    "description": "Standardizes and validates API responses in NestJS for consistent and reliable communication",
    "author": "",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-response.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "format": "prettier --write \"sample/**/*.ts\" \"lib/**/*.ts\"",
        "start": "nest start",
        "start:dev": "npm run prebuild && nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{sample,apps,lib,test}/**/*.ts\" --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "wz-command": "wz-command",
        "prepare": "is-ci || husky",
        "version": "auto-changelog && git add CHANGELOG.md",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "lint-staged": "lint-staged",
        "cspell": "cspell"
    },
    "devDependencies": {
        "@grpc/grpc-js": "^1.12.4",
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/swagger": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@swc/core": "^1.13.5",
        "@types/express": "5.0.6",
        "@types/node": "25.2.0",
        "@types/supertest": "6.0.3",
        "auto-changelog": "2.5.0",
        "class-transformer": "0.5.1",
        "class-validator": "npm:@hodfords/turbo-validator@1.0.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "rxjs": "7.8.2",
        "source-map-support": "0.5.21",
        "supertest": "7.2.2",
        "ts-loader": "9.5.4",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0"
    },
    "overrides": {
        "lodash": "4.17.23",
        "@nestjs/schematics": {
            "typescript": "$typescript"
        },
        "@nestjs/cli": {
            "typescript": "$typescript"
        }
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3"
    }
}
